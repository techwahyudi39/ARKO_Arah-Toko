generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String   @id @default(uuid())
  name     String
  email    String   @unique
  password String
  role     String   @default("TENANT_EDITOR") // "SUPER_ADMIN", "TENANT_EDITOR"
  tenants  Tenant[]
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  type        String   // "PRODUCT", "COMPANY_PROFILE"
  description String
  logoUrl     String?  // Google Drive Direct Link
  waNumber    String   // Kontak WhatsApp Marketing
  address     String?
  socialMedia String?  // JSON
  createdAt   DateTime @default(now())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  items       Item[]
  categories  Category[]
}

model Item {
  id          String   @id @default(uuid())
  name        String
  slug        String
  type        String   // "PRODUCT", "SERVICE"
  description String
  price       Float?
  images      String?  // JSON array of GDrive Direct Links
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  
  @@unique([tenantId, slug])
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String
  type        String   // "GLOBAL", "TENANT"
  
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  items       Item[]
  
  @@unique([tenantId, slug])
}
